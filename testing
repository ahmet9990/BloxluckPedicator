-- En yakındaki parayı bulma fonksiyonu (Coin_Server)
local function getClosestCoin()
    local character = LocalPlayer.Character
    if not character or not character:FindFirstChild("HumanoidRootPart") then return nil end
    
    local rootPart = character.HumanoidRootPart
    local closestCoin = nil
    local shortestDistance = math.huge
    
    for _, item in pairs(Workspace:GetDescendants()) do
        if item.Name == "Coin_Server" and item:IsA("BasePart") then
            local distance = (item.Position - rootPart.Position).Magnitude
            if distance < shortestDistance then
                shortestDistance = distance
                closestCoin = item
            end
        end
    end
    return closestCoin
end

-- Belirlenen paraya yumuşak geçiş (Tween) yapma fonksiyonu
local function tweenToCoin(coin)
    local character = LocalPlayer.Character
    if not character or not character:FindFirstChild("HumanoidRootPart") then return end
    
    local rootPart = character.HumanoidRootPart
    local distance = (coin.Position - rootPart.Position).Magnitude
    
    -- Dinamik hız ayarı direkt GUI'den alınır
    local speed = _G.TweenSpeed
    local timeToTween = distance / speed
    
    local tweenInfo = TweenInfo.new(timeToTween, Enum.EasingStyle.Linear)
    local tween = TweenService:Create(rootPart, tweenInfo, {CFrame = coin.CFrame})
    
    tween:Play()
    
    -- Farm kapatılırsa veya karakter ölürse tween hareketini anında kesmek için kontrol döngüsü
    while tween.PlaybackState == Enum.PlaybackState.Playing do
        if not _G.AutoFarmEnabled or not coin:IsDescendantOf(Workspace) or not character:FindFirstChild("HumanoidRootPart") then
            tween:Cancel()
            break
        end
        task.wait()
    end
end

-- Ana Farm Döngüsü
task.spawn(function()
    while true do
        task.wait(0.3)
        if _G.AutoFarmEnabled then
            local targetCoin = getClosestCoin()
            if targetCoin and targetCoin:IsDescendantOf(Workspace) then
                tweenToCoin(targetCoin)
                task.wait(0.1)
            end
        end
    end
end)

