-- ==========================================
-- FARM FONKSİYONLARI
-- ==========================================
local function getClosestCoin()
	local char = LocalPlayer.Character
	if not char then return nil end
	local root = char:FindFirstChild("HumanoidRootPart")
	if not root then return nil end

	local closest, shortest = nil, math.huge

	-- Coin ve Candy'leri daha verimli ara
	for _, item in pairs(Workspace:GetDescendants()) do
		if (item.Name == "Coin_Server" or item.Name == "Candy_Server") and item:IsA("BasePart") then
			local dist = (item.Position - root.Position).Magnitude
			if dist < shortest then
				shortest = dist
				closest = item
			end
		end
	end
	return closest
end

local function getCollectedCoins()
	local leaderstats = LocalPlayer:FindFirstChild("leaderstats")
	if not leaderstats then return 0 end
	for _, stat in pairs(leaderstats:GetChildren()) do
		if stat.Name == "Coins" or stat.Name == "Coin" or stat.Name == "Collected" or stat.Name == "Candies" then
			return stat.Value
		end
	end
	return 0
end

local function moveToCoin(coin)
	local char = LocalPlayer.Character
	if not char then return end
	local root = char:FindFirstChild("HumanoidRootPart")
	if not root or not coin or not coin:IsDescendantOf(Workspace) then return end

	if _G.MovementMode == "Tween" then
		if currentTween then
			currentTween:Cancel()
			currentTween = nil
		end

		local dist = (coin.Position - root.Position).Magnitude
		local speed = math.clamp(_G.MovementSpeed, 10, 250)
		local timeToTween = math.clamp(dist / speed, 0.05, 8)

		-- Velocity temizle
		root.AssemblyLinearVelocity = Vector3.zero
		root.AssemblyAngularVelocity = Vector3.zero

		local info = TweenInfo.new(timeToTween, Enum.EasingStyle.Linear)
		currentTween = TweenService:Create(root, info, {CFrame = coin.CFrame + Vector3.new(0, 2, 0)})
		currentTween:Play()

		local start = tick()
		while currentTween and currentTween.PlaybackState == Enum.PlaybackState.Playing do
			if not _G.AutoFarmEnabled or _G.MovementMode ~= "Tween" or not coin:IsDescendantOf(Workspace) then
				currentTween:Cancel()
				currentTween = nil
				break
			end
			if tick() - start > 10 then -- timeout
				currentTween:Cancel()
				currentTween = nil
				break
			end
			task.wait()
		end
		currentTween = nil
	else
		-- Teleport Modu
		root.AssemblyLinearVelocity = Vector3.zero
		root.CFrame = coin.CFrame + Vector3.new(0, 2, 0)
		task.wait(math.clamp(_G.MovementSpeed / 1000, 0.03, 0.25)) -- daha mantıklı bekleme
	end
end

