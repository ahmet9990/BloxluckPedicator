-- ======================
function stopAllMovement()
	isMoving = false
	currentTarget = nil

	if currentTween then
		pcall(function() currentTween:Cancel() end)
		currentTween = nil
	end
	if flyBV then
		pcall(function() flyBV:Destroy() end)
		flyBV = nil
	end
	destroyPlatform()
end

local function getClosestCoin(exclude)
	local char = LocalPlayer.Character
	if not char then return nil end
	local root = char:FindFirstChild("HumanoidRootPart")
	if not root then return nil end

	local closest, shortest = nil, math.huge

	for _, item in pairs(Workspace:GetDescendants()) do
		if (item.Name == "Coin_Server" or item.Name == "Candy_Server") and item:IsA("BasePart") then
			if item.Transparency >= 0.9 then continue end
			if exclude and item == exclude then continue end

			local dist = (item.Position - root.Position).Magnitude
			if dist < shortest then
				shortest = dist
				closest = item
			end
		end
	end
	return closest
end

local function bringAllCoins()
	local char = LocalPlayer.Character
	if not char then return end
	local root = char:FindFirstChild("HumanoidRootPart")
	if not root then return end

	for _, item in pairs(Workspace:GetDescendants()) do
		if (item.Name == "Coin_Server" or item.Name == "Candy_Server") and item:IsA("BasePart") then
			if item.Transparency < 0.9 then
				item.CFrame = root.CFrame * CFrame.new(math.random(-4, 4), 1.5, math.random(-4, 4))
			end
		end
	end
end

local function isNearCoin(coin, maxDist)
	maxDist = maxDist or 6
	local char = LocalPlayer.Character
	if not char then return false end
	local root = char:FindFirstChild("HumanoidRootPart")
	if not root or not coin then return false end
	return (root.Position - coin.Position).Magnitude <= maxDist
end

-- ======================
-- HAREKET MODLARI (başarı durumu döndürür)
-- ======================
local function moveTween(coin)
	local char = LocalPlayer.Character
	if not char then return false end
	local root = char:FindFirstChild("HumanoidRootPart")
	if not root or not coin then return false end

	createPlatform()

	local dist = (coin.Position - root.Position).Magnitude
	local speed = math.clamp(_G.MovementSpeed, 20, 200)
	local duration = math.clamp(dist / speed, 0.08, 6)

	root.AssemblyLinearVelocity = Vector3.zero
	root.AssemblyAngularVelocity = Vector3.zero

	local target = coin.CFrame + Vector3.new(0, 2.6, 0)
	local info = TweenInfo.new(duration, Enum.EasingStyle.Linear)

	currentTween = TweenService:Create(root, info, {CFrame = target})
	currentTween:Play()

	if platform then
		TweenService:Create(platform, info, {
			CFrame = target * CFrame.new(0, -3.0, 0)
		}):Play()
	end

	local start = tick()
	while currentTween and currentTween.PlaybackState == Enum.PlaybackState.Playing do
		if not _G.AutoFarmEnabled or not coin:IsDescendantOf(Workspace) or coin.Transparency >= 0.9 then
			return false
		end
		if tick() - start > 8 then return false end
		task.wait()
	end

	return isNearCoin(coin, 7)
end

local function moveFly(coin)
	local char = LocalPlayer.Character
	if not char then return false end
	local root = char:FindFirstChild("HumanoidRootPart")
	if not root or not coin then return false end

	if flyBV then
		flyBV:Destroy()
		flyBV = nil
	end

	flyBV = Instance.new("BodyVelocity")
	flyBV.MaxForce = Vector3.new(50000, 50000, 50000)
	flyBV.P = 12000
	flyBV.Velocity = Vector3.zero
	flyBV.Parent = root

	local speed = math.clamp(_G.MovementSpeed, 25, 180)
	local start = tick()

	while _G.AutoFarmEnabled and coin and coin:IsDescendantOf(Workspace) and coin.Transparency < 0.9 do
		local direction = (coin.Position + Vector3.new(0, 2.4, 0) - root.Position)
		local dist = direction.Magnitude

		if dist < 5 then
			flyBV.Velocity = Vector3.zero
			break
		end

		flyBV.Velocity = direction.Unit * speed
		if tick() - start > 7 then break end
		task.wait()
	end

	if flyBV then
		flyBV.Velocity = Vector3.zero
	end

	return isNearCoin(coin, 7)
end

local function moveTeleport(coin)
	local char = LocalPlayer.Character
	if not char then return false end
	local root = char:FindFirstChild("HumanoidRootPart")
	if not root or not coin then return false end

	root.AssemblyLinearVelocity = Vector3.zero
	root.CFrame = coin.CFrame + Vector3.new(0, 2.6, 0)
	return true
end

local function goToCoin(coin)
	if isMoving then return false end
	isMoving = true
	currentTarget = coin

	local success = false
	if _G.MovementMode == "Tween" then
		success = moveTween(coin)
	elseif _G.MovementMode == "Fly" then
		success = moveFly(coin)
	else
		success = moveTeleport(coin)
	end

	isMoving = false
	currentTarget = nil
	return success
end

-- ======================
-- ANA DÖNGÜ (sıfır bekleme)
-- ======================
task.spawn(function()
	while true do
		if not _G.AutoFarmEnabled then
			if isMoving then stopAllMovement() end
			task.wait(0.1)
			continue
		end

		local char = LocalPlayer.Character
		if not char or not char:FindFirstChild("HumanoidRootPart") then
			task.wait(0.6)
			continue
		end

		if _G.BringCoinsEnabled then
			bringAllCoins()
			task.wait(0.2)
			continue
		end

		local coin = getClosestCoin()
		if coin then
			-- Mevcut hedef farklıysa veya hareket yoksa hemen git
			if currentTarget ~= coin or not isMoving then
				if isMoving then
					stopAllMovement()
				end

				local success = goToCoin(coin)

				-- Başarılı olduysa (konuma ulaştıysa) hiç beklemeden sıradakine geç
				if success then
					-- coin yok olduysa veya hala varsa fark etmez, direkt sonraki en yakını al
					-- burada hiçbir task.wait yok
				end
			end
		else
			StatusLabel.Text = "Durum: Coin aranıyor..."
			if isMoving then stopAllMovement() end
			task.wait(0.25)
		end

		-- Sadece çok kısa bir nefes alma (CPU için)
		task.wait(0.03)
	end
end)

