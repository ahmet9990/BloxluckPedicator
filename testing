-- En yakın coini/candy'yi bul
local function getClosestCoin()
    local char = LocalPlayer.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return nil end
    local root = char.HumanoidRootPart
    local closest, shortest = nil, math.huge
    
    for _, item in pairs(Workspace:GetDescendants()) do
        if (item.Name == "Coin_Server" or item.Name == "Candy_Server") and item:IsA("BasePart") then
            local dist = (item.Position - root.Position).Magnitude
            if dist < shortest then
                shortest = dist
                closest = item
            end
        end
    end
    return closest
end

-- Oyuncunun coin sayısını bulma
local function getCollectedCoins()
    local leaderstats = LocalPlayer:FindFirstChild("leaderstats")
    if leaderstats then
        for _, stat in pairs(leaderstats:GetChildren()) do
            if stat.Name == "Coins" or stat.Name == "Coin" or stat.Name == "Collected" or stat.Name == "Candies" then
                return stat.Value
            end
        end
    end
    return 0
end

-- Ultra Smooth Tween ve Teleport (Çakışmasız)
local function moveToCoin(coin)
    local char = LocalPlayer.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return end
    local root = char.HumanoidRootPart
    
    if _G.MovementMode == "Tween" then
        if currentTween then
            currentTween:Cancel()
            currentTween = nil
        end
        
        local dist = (coin.Position - root.Position).Magnitude
        local speed = math.clamp(_G.MovementSpeed, 5, 300)
        local timeToTween = dist / speed
        
        root.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
        root.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
        
        local info = TweenInfo.new(timeToTween, Enum.EasingStyle.Linear)
        currentTween = TweenService:Create(root, info, {CFrame = coin.CFrame})
        currentTween:Play()
        
        while currentTween and currentTween.PlaybackState == Enum.PlaybackState.Playing do
            if not _G.AutoFarmEnabled or _G.MovementMode ~= "Tween" or not coin:IsDescendantOf(Workspace) or not char:FindFirstChild("HumanoidRootPart") then
                currentTween:Cancel()
                currentTween = nil
                break
            end
            task.wait()
        end
        currentTween = nil
    else
        -- Teleport Modu
        root.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
        root.CFrame = coin.CFrame
        task.wait(math.clamp(_G.MovementSpeed / 200, 0.01, 0.1))
    end
end

-- Fling Fonksiyonu
local function startFlingLoop()
    local char = LocalPlayer.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return end
    local root = char.HumanoidRootPart
    
    local startTime = tick()
    local noclipConnection
    local resetDetected = false
    
    noclipConnection = RunService.Stepped:Connect(function()
        for _, part in pairs(char:GetDescendants()) do
            if part:IsA("BasePart") then
                part.CanCollide = false
            end
        end
    end)
    
    local humanoid = char:FindFirstChildOfClass("Humanoid")
    if humanoid then
        humanoid.Died:Connect(function()
            resetDetected = true
        end)
    end
    
    while tick() - startTime < 7 and not resetDetected do
        local targetPlayer = nil
        local shortestDist = math.huge
        
        for _, p in pairs(Players:GetPlayers()) do
            if p ~= LocalPlayer and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
                local d = (p.Character.HumanoidRootPart.Position - root.Position).Magnitude
                if d < shortestDist then
                    shortestDist = d
                    targetPlayer = p.Character.HumanoidRootPart
                end
            end
        end
        
        if targetPlayer then
            root.CFrame = targetPlayer.CFrame
            root.Velocity = Vector3.new(99999, 99999, 99999)
            root.RotVelocity = Vector3.new(99999, 99999, 99999)
        end
        task.wait(0.05)
    end
    
    if noclipConnection then
        noclipConnection:Disconnect()
    end
end

-- Ana Farm Döngüsü
task.spawn(function()
    while true do
        task.wait(0.2)
        if _G.AutoFarmEnabled then
            local coin = getClosestCoin()
            if coin and coin:IsDescendantOf(Workspace) then
                moveToCoin(coin)
            else
                task.wait(0.8)
                local currentCoins = getCollectedCoins()
                if currentCoins >= 50 and (currentCoins % 50 == 0) then
                    local char = LocalPlayer.Character
                    local humanoid = char and char:FindFirstChildOfClass("Humanoid")
                    if humanoid and humanoid.Health <= 0 then
                        startFlingLoop()
                        LocalPlayer.Character:BreakJoints()
                        task.wait(5)
                    end
                end
            end
        end
    end
end)
