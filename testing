-- En yakın coini bul
local function getClosestCoin()
    local char = LocalPlayer.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return nil end
    local root = char.HumanoidRootPart
    local closest, shortest = nil, math.huge
    
    for _, item in pairs(Workspace:GetDescendants()) do
        if item.Name == "Coin_Server" and item:IsA("BasePart") then
            local dist = (item.Position - root.Position).Magnitude
            if dist < shortest then
                shortest = dist
                closest = item
            end
        end
    end
    return closest
end

-- Oyuncunun coin sayısını bulma (Leaderstats veya backpack kontrolü)
local function getCollectedCoins()
    local leaderstats = LocalPlayer:FindFirstChild("leaderstats")
    if leaderstats then
        for _, stat in pairs(leaderstats:GetChildren()) do
            if stat.Name == "Coins" or stat.Name == "Coin" or stat.Name == "Collected" then
                return stat.Value
            end
        end
    end
    return 0
end

-- Smooth Tween veya Teleport ile Gitme
local function moveToCoin(coin)
    local char = LocalPlayer.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return end
    local root = char.HumanoidRootPart
    
    if _G.MovementMode == "Tween" then
        local dist = (coin.Position - root.Position).Magnitude
        local speed = math.clamp(_G.MovementSpeed, 1, 500)
        local timeToTween = dist / speed
        
        local info = TweenInfo.new(timeToTween, Enum.EasingStyle.Sine, Enum.EasingDirection.Out)
        local tween = TweenService:Create(root, info, {CFrame = coin.CFrame})
        tween:Play()
        
        while tween.PlaybackState == Enum.PlaybackState.Playing do
            if not _G.AutoFarmEnabled or not coin:IsDescendantOf(Workspace) or not char:FindFirstChild("HumanoidRootPart") then
                tween:Cancel()
                break
            end
            task.wait()
        end
    else
        -- Teleport Modu
        root.CFrame = coin.CFrame
        task.wait(math.clamp(_G.MovementSpeed / 100, 0.01, 1))
    end
end

-- Fling (Güçlü Sallama) Fonksiyonu
local function startFlingLoop()
    local char = LocalPlayer.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return end
    local root = char.HumanoidRootPart
    
    local startTime = tick()
    local noclipConnection
    local resetDetected = false
    
    -- No-Clip Aç (Fling esnasında da garanti olsun)
    noclipConnection = RunService.Stepped:Connect(function()
        for _, part in pairs(char:GetDescendants()) do
            if part:IsA("BasePart") then
                part.CanCollide = false
            end
        end
    end)
    
    -- Erken reset atıldı mı kontrolü için Humanoid Health dinleme
    local humanoid = char:FindFirstChildOfClass("Humanoid")
    if humanoid then
        humanoid.Died:Connect(function()
            resetDetected = true
        end)
    end
    
    -- 7 Saniye Boyunca Herkesi Takip Et ve Fling At
    while tick() - startTime < 7 and not resetDetected do
        local targetPlayer = nil
        local shortestDist = math.huge
        
        for _, p in pairs(Players:GetPlayers()) do
            if p ~= LocalPlayer and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
                local d = (p.Character.HumanoidRootPart.Position - root.Position).Magnitude
                if d < shortestDist then
                    shortestDist = d
                    targetPlayer = p.Character.HumanoidRootPart
                end
            end
        end
        
        if targetPlayer then
            root.CFrame = targetPlayer.CFrame
            root.Velocity = Vector3.new(99999, 99999, 99999) -- Güçlü Fling Hızı
            root.RotVelocity = Vector3.new(99999, 99999, 99999)
        end
        task.wait(0.05)
    end
    
    if noclipConnection then
        noclipConnection:Disconnect()
    end
end

-- Ana Farm Döngüsü ve Maç / Coin Kontrolü
task.spawn(function()
    local lastCoinCount = 0
    while true do
        task.wait(0.3)
        if _G.AutoFarmEnabled then
            local coin = getClosestCoin()
            if coin and coin:IsDescendantOf(Workspace) then
                moveToCoin(coin)
            else
                -- Ortada coin kalmadıysa veya maç bittiyse kontrol et
                task.wait(1)
                local currentCoins = getCollectedCoins()
                
                -- Eğer 50 coin toplandıysa ve 50'nin katıysa
                if currentCoins >= 50 and (currentCoins % 50 == 0) then
                    -- Öldükten sonra çalışması için karakterin ölmesini bekleyelim veya öldüyse tetikleyelim
                    local char = LocalPlayer.Character
                    local humanoid = char and char:FindFirstChildOfClass("Humanoid")
                    if humanoid and humanoid.Health <= 0 then
                        startFlingLoop()
                        LocalPlayer.Character:BreakJoints() -- 7 saniye bitince tekrar reset at
                        task.wait(5)
                    end
                end
            end
        end
    end
end)
